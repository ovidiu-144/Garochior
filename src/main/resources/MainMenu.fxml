<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="1080" prefWidth="1920" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.Garochior.ui.MainMenuController">
   <children>
        <ImageView fx:id="background" fitHeight="1080.0" fitWidth="1920.0" pickOnBounds="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
          <image>
             <Image url="@background/barca_25-26.jpg" />
          </image>
        </ImageView>
      <HBox prefHeight="900.0" prefWidth="689.0">
         <children>
            <VBox accessibleRole="IMAGE_VIEW" prefHeight="818.0" prefWidth="559.0" spacing="250.0">
               <children>
                  <Button fx:id="serverBtn" mnemonicParsing="false" onAction="#onServerClicked" onMouseEntered="#onButtonEntered" onMouseExited="#onButtonExit" prefHeight="200" prefWidth="300" style="-fx-background-color: red;" text="Create Server" />
                  <Button fx:id="clientBtn" mnemonicParsing="false" onAction="#onClientClicked" onMouseEntered="#onButtonEntered" onMouseExited="#onButtonExit" prefHeight="200" prefWidth="300" style="-fx-background-color: red;" text="Join Server" />
                  <Button fx:id="exitBtn" mnemonicParsing="false" onAction="#onExitClicked" onMouseEntered="#onButtonEntered" onMouseExited="#onButtonExit" prefHeight="200" prefWidth="300" style="-fx-background-color: red;" text="Exit" />
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
            </VBox>
            <VBox prefHeight="864.0" prefWidth="607.0" spacing="250">
               <children>
                  <VBox fx:id="serverLayout" prefHeight="133.0" prefWidth="370.0">
                     <children>
                        <HBox prefHeight="34.0" prefWidth="370.0" spacing="10">
                           <children>
                              <Label alignment="CENTER" prefHeight="34.0" prefWidth="57.0" style="-fx-background-color: transparent; -fx-font-family: Arial; -fx-font-weight: BOLD; -fx-font-size: 16;" text="ROOM" textFill="YELLOW" />
                              <TextField fx:id="roomField" prefHeight="30" prefWidth="138.0" />
                           </children>
                        </HBox>
                        <Button fx:id="confirmServerBtn" mnemonicParsing="false" onAction="#onConfirmServerClicked" text="Confirm" />
                     </children></VBox>
                  <VBox fx:id="clientLayout" prefHeight="300.0" prefWidth="370.0" spacing="15" visible="false">
                     <HBox prefHeight="34.0" prefWidth="370.0" spacing="10">
                        <Label alignment="CENTER" prefHeight="34.0" prefWidth="57.0"
                               style="-fx-background-color: transparent; -fx-font-family: Arial; -fx-font-weight: BOLD; -fx-font-size: 16;"
                               text="ROOM" textFill="YELLOW" />
                        <TextField fx:id="clientRoomField" prefHeight="30" prefWidth="150" />
                        <Button fx:id="searchRoomBtn" mnemonicParsing="false" onAction="#onSearchRoomClicked" text="Search" />
                     </HBox>

                     <!-- Cele 4 sloturi de jucători -->
                     <HBox fx:id="playerSlots" spacing="10" alignment="CENTER_LEFT" visible="false">
                        <Button fx:id="player0Btn" userData="0" prefWidth="80" prefHeight="80" text="HOST"
                                onAction="#onConfirmServerClicked"
                                style="-fx-background-color: #888; -fx-text-fill: white; -fx-font-size: 12px;
                       -fx-background-radius: 10;" disable="true" />
                        <Button fx:id="player1Btn" prefWidth="80" prefHeight="80" text="Liber"
                                onAction="#onSlotClicked" userData="1"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 12px;
                       -fx-background-radius: 10;" />
                        <Button fx:id="player2Btn" prefWidth="80" prefHeight="80" text="Liber"
                                onAction="#onSlotClicked" userData="2"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 12px;
                       -fx-background-radius: 10;" />
                        <Button fx:id="player3Btn" prefWidth="80" prefHeight="80" text="Liber"
                                onAction="#onSlotClicked" userData="3"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 12px;
                       -fx-background-radius: 10;" />
                     </HBox>
                  </VBox>

               </children></VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
