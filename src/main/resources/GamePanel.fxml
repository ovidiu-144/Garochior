<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.control.Label?>

<?import javafx.scene.control.Button?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.Garochior.game.GamePanelController">

    <ImageView fx:id="background" fitHeight="1207.0" fitWidth="1920.0" pickOnBounds="true" AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <image>
            <Image url="@background/table.jpeg"/>
        </image>
    </ImageView>
    <HBox fx:id="player1Box" alignment="CENTER" layoutX="23.0" layoutY="845.0" prefHeight="214.0" prefWidth="1920.0"
          spacing="45" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="0.0">
    </HBox>

    <HBox alignment="CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="30.0">
        <children>
            <Label fx:id="scoreLabel" text="Score: 0"
                   style="-fx-font-size: 32px; -fx-text-fill: white; -fx-font-weight: bold;
                          -fx-background-color: rgba(0, 0, 0, 0.5); -fx-padding: 10 30 10 30;
                          -fx-background-radius: 20;" />

            <Label fx:id="gameLabel" text="Game: "
                   style="-fx-font-size: 32px; -fx-text-fill: white; -fx-font-weight: bold;
                          -fx-background-color: rgba(0, 0, 0, 0.5); -fx-padding: 10 30 10 30;
                          -fx-background-radius: 20;" />
            <Label fx:id="turnLabel" text="Așteptăm jucătorii..."
                   style="-fx-font-size: 32px; -fx-text-fill: white; -fx-font-weight: bold;
                          -fx-background-color: rgba(0, 0, 0, 0.5); -fx-padding: 10 30 10 30;
                          -fx-background-radius: 20;" />
        </children>
    </HBox>

    <VBox fx:id="centerVBox" alignment="CENTER" layoutX="610.0" layoutY="178.0" prefHeight="450.0" prefWidth="337.0"
          spacing="50">
        <ImageView fitHeight="150.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" rotate="180"/>
        <HBox fx:id="centerHBox" alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="500.0">
            <ImageView fitHeight="150.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true"
                       rotate="270"/>
            <ImageView fitHeight="150.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" rotate="90"/>
        </HBox>
        <ImageView fitHeight="150.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true"/>
    </VBox>


    <Button text="ESC" onAction="#onEscClicked"
            AnchorPane.topAnchor="30.0" AnchorPane.rightAnchor="30.0"
            style="-fx-background-color: rgba(0,0,0,0.5); -fx-text-fill: white;
                   -fx-font-size: 18px; -fx-padding: 8 20 8 20; -fx-background-radius: 10;" />



    <VBox fx:id="tabouGridBox" visible="true" alignment="CENTER" spacing="10"
          AnchorPane.topAnchor="100.0" AnchorPane.bottomAnchor="100.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
    </VBox>
    <!-- Pause Menu Overlay -->
    <VBox fx:id="pauseMenu" visible="false" alignment="CENTER" spacing="20"
          AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          style="-fx-background-color: rgba(0,0,0,0.7);">
        <Label text="Meniu"
               style="-fx-font-size: 48px; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Button text="Continuă" onAction="#onResumeClicked"
                prefWidth="250" prefHeight="60"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;
                       -fx-font-size: 20px; -fx-background-radius: 10;" />
        <Button text="Deconectare" onAction="#onDisconnectClicked"
                prefWidth="250" prefHeight="60"
                style="-fx-background-color: #f44336; -fx-text-fill: white;
                       -fx-font-size: 20px; -fx-background-radius: 10;" />
    </VBox>
</AnchorPane>
